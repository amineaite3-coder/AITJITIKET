# ==============================================================================
# SERVER RUNTIME ENVIRONMENT VARIABLES (Backend Express only — NEVER expose to browser)
# ==============================================================================
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
NODE_ENV="production"
# Hostinger automatically injects PORT; default fallback is 3000.
PORT="3000"
APP_URL="https://your-domain.com"

# ==============================================================================
# FRONTEND BUILD-TIME ENVIRONMENT VARIABLES (Injected by Vite during `npm run build`)
# ==============================================================================
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"
VITE_FIREBASE_DATABASE_ID="your-firestore-database-id"
# Optional:
VITE_FIREBASE_MEASUREMENT_ID=""
